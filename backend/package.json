{
    "name": "ai-study-helper-backend",
    "version": "1.0.0",
    "description": "PDF study helper API with Gemini and PostgreSQL vector retrieval",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "tsx src/db/migrate.ts",
        "migrate:prod": "node dist/db/migrate.js",
        "test": "tsx --test test/*.test.ts"
    },
    "keywords": [
        "nodejs",
        "typescript",
        "express",
        "backend",
        "template",
        "starter"
    ],
    "author": "",
    "license": "MIT",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@google/genai": "^2.23.0",
        "cors": "^2.8.6",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "kysely": "^0.29.6",
        "multer": "^2.4.0",
        "pdf-parse": "^2.4.5",
        "pg": "^8.23.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@electric-sql/pglite-pgvector": "^0.0.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.9.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.0",
        "tsx": "^4.6.2",
        "typescript": "^5.2.2"
    }
}
